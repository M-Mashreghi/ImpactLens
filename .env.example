# ImpactLens configuration — placeholders only. Copy to .env and fill in locally.
# Never commit .env or real credentials.

# --- Application ---
IMPACTLENS_ENV=development            # development | test | production
IMPACTLENS_LOG_LEVEL=INFO
IMPACTLENS_LOG_FORMAT=json            # json | text
IMPACTLENS_DB_PATH=./var/impactlens.db
IMPACTLENS_CACHE_DIR=./var/cache
IMPACTLENS_SAMPLES_DIR=./data/samples

# --- LLM ---
LLM_PROVIDER=fixture                  # fixture (offline demo) | openai_compatible
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=replace-me
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- News ---
NEWS_POLL_INTERVAL_SECONDS=900
# Comma-separated key|url pairs, e.g. examplewire|https://example.com/feed.xml
NEWS_RSS_FEEDS=
NEWS_DISABLED_SOURCES=
NEWS_HTTP_TIMEOUT_SECONDS=15
NEWS_USER_AGENT=ImpactLens/1.0 (+research; contact: replace-me)

# --- Market data ---
MARKET_DATA_PROVIDER=csv              # csv | none
MARKET_DATA_API_KEY=replace-me
MARKET_DATA_CSV_DIR=./data/samples/prices
MARKET_DATA_CACHE_MAX_ENTRIES=500

# --- Exposure rules ---
# Comma-separated indirect families to disable: sector,industry,country,commodity,macro,relationship
EXPOSURE_DISABLED_FAMILIES=

# --- Alerts ---
ALERTS_ENABLED=false
ALERT_CHANNEL=console                 # console | webhook
ALERT_WEBHOOK_URL=
ALERT_MIN_LEVEL=High                  # Low | Medium | High | Critical
ALERT_COOLDOWN_SECONDS=3600

# --- Dashboard ---
IMPACTLENS_API_URL=http://localhost:8000
